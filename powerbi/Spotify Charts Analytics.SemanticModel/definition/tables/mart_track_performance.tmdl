table mart_track_performance
	lineageTag: 1167898d-c050-5518-a95d-de714f67af3f

	measure 'Median Chart Life (days)' = MEDIAN ( mart_track_performance[total_chart_days] )
		formatString: 0
		displayFolder: Track life
		lineageTag: bb7554e0-d8d7-53dd-8a0b-4a8a58552560

	measure 'Peaked on Debut %' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( mart_track_performance ),
			        mart_track_performance[peaked_on_debut] = TRUE ()
			    ),
			    COUNTROWS ( mart_track_performance )
			)
		formatString: 0%
		displayFolder: Track life
		lineageTag: cdacff93-257c-58f3-aea0-2dc90991bbb1

	measure 'Median Days in First 180' =
			CALCULATE (
			    MEDIAN ( mart_track_performance[chart_days_first_180] ),
			    mart_track_performance[is_left_censored] = FALSE (),
			    mart_track_performance[has_full_180_day_window] = TRUE ()
			)
		formatString: 0
		displayFolder: Track life
		lineageTag: 9a747b28-6c8a-52e9-82b6-d8bc02211132

	measure 'Days on Chart' =
			CALCULATE (
			    SUM ( mart_track_performance[total_chart_days] ),
			    CROSSFILTER ( bridge_track_artist[track_key], dim_track[track_key], BOTH )
			)
		formatString: #,0
		displayFolder: Track life
		lineageTag: 5759893a-0422-5bb3-8c41-88a164b50cd0

	measure Tracks = COUNTROWS ( mart_track_performance )
		formatString: #,0
		displayFolder: Track life
		lineageTag: 89f9d8d5-82df-5e96-869e-ee81244906fc

	measure 'Top Track' =
			VAR FocusRank = MIN ( dim_track[chart_rank] )
			RETURN
			    CALCULATE ( MAX ( dim_track[track_label] ), dim_track[chart_rank] = FocusRank )
		displayFolder: Track life
		lineageTag: 4604cea3-4729-50b9-a433-c72e9492e3c8

	measure 'Peak Position' =
			VAR FocusRank = MIN ( dim_track[chart_rank] )
			RETURN
			    CALCULATE (
			        MIN ( mart_track_performance[peak_position] ),
			        dim_track[chart_rank] = FocusRank
			    )
		formatString: 0
		displayFolder: Song
		lineageTag: 4c89c35c-826f-50b9-be29-661409d7c2e0

	measure 'Debut Position' =
			VAR FocusRank = MIN ( dim_track[chart_rank] )
			RETURN
			    CALCULATE (
			        MIN ( mart_track_performance[debut_position] ),
			        dim_track[chart_rank] = FocusRank
			    )
		formatString: 0
		displayFolder: Song
		lineageTag: 28523857-8785-5fb5-87fb-fa541ee77711

	measure 'Release Year' =
			VAR FocusRank = MIN ( dim_track[chart_rank] )
			RETURN
			    CALCULATE (
			        YEAR ( MIN ( mart_track_performance[release_date] ) ),
			        dim_track[chart_rank] = FocusRank
			    )
		formatString: 0
		displayFolder: Song
		lineageTag: d8f88238-d4fb-505c-8006-6e8546184e29

	measure 'Explicit Label' =
			VAR FocusRank = MIN ( dim_track[chart_rank] )
			VAR IsExplicit =
			    CALCULATE (
			        COUNTROWS ( mart_track_performance ),
			        dim_track[chart_rank] = FocusRank,
			        mart_track_performance[debut_is_explicit] = TRUE ()
			    )
			RETURN
			    IF ( ISBLANK ( FocusRank ), BLANK (), IF ( IsExplicit > 0, "Yes", "No" ) )
		displayFolder: Song
		lineageTag: d809f3e1-492b-5ca3-8c69-a78e0c681aa0

	measure 'Album Type' =
			VAR FocusRank = MIN ( dim_track[chart_rank] )
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( mart_track_performance[debut_album_type] ),
			        dim_track[chart_rank] = FocusRank
			    )
		displayFolder: Song
		lineageTag: 21fb8bc9-5f35-54c1-b71d-5525725a887b

	measure Song =
			VAR FocusRank = MIN ( dim_track[chart_rank] )
			RETURN
			    CALCULATE ( MAX ( dim_track[track_label] ), dim_track[chart_rank] = FocusRank )
		displayFolder: Song
		lineageTag: c16be70e-ff89-5a92-9b11-cbe5e48db634

	measure 'Song Days on Chart' =
			VAR FocusRank = MIN ( dim_track[chart_rank] )
			RETURN
			    CALCULATE (
			        SUM ( mart_track_performance[total_chart_days] ),
			        dim_track[chart_rank] = FocusRank
			    )
		formatString: #,0
		displayFolder: Song
		lineageTag: 739aaf23-4e50-50fe-90d4-f0deaf404c74

