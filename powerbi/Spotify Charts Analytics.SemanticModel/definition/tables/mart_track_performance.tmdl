	partition mart_track_performance = m
		mode: import
		source =
				let
				    FileName = "mart_track_performance.parquet",
				    Content = if Text.StartsWith(DataLocation, "http")
				        then Web.Contents(DataLocation & FileName)
				        else File.Contents(DataLocation & FileName),
				    Source = Parquet.Document(Binary.Buffer(Content))
				in
				    Source

	annotation PBI_ResultType = Table
