// Generated by `spotify-pipeline powerbi` from spotify_pipeline/powerbi.py.
// The same measures are already defined in the PBIP semantic model.

// ---------------------------------------------------------------- Chart
// Number of chart entries (track x day).  [table: fact_chart_entry]
Chart Entries =
COUNTROWS ( fact_chart_entry )

// Distinct tracks on the chart.  [table: fact_chart_entry]
Tracks Charting =
DISTINCTCOUNT ( fact_chart_entry[track_key] )

// Number of daily chart snapshots.  [table: fact_chart_entry]
Snapshots =
DISTINCTCOUNT ( fact_chart_entry[chart_date] )

// Average Spotify popularity of charting tracks.  [table: fact_chart_entry]
Avg Popularity =
AVERAGE ( fact_chart_entry[popularity] )

// ---------------------------------------------------------------- Movement
// Chart entries that are a track's first-ever appearance.  [table: fact_chart_entry]
Debuts =
CALCULATE ( [Chart Entries], fact_chart_entry[entry_status] = "debut" )

// Chart entries where a track returns after dropping out.  [table: fact_chart_entry]
Re-entries =
CALCULATE ( [Chart Entries], fact_chart_entry[entry_status] = "re-entry" )

// Share of chart entries new versus the previous snapshot (first snapshot excluded).  [table: fact_chart_entry]
Turnover Rate =
VAR FirstSnapshot =
    CALCULATE ( MIN ( fact_chart_entry[chart_date] ), ALL ( fact_chart_entry ) )
RETURN
    DIVIDE (
        CALCULATE (
            [Debuts] + [Re-entries],
            fact_chart_entry[chart_date] <> FirstSnapshot
        ),
        CALCULATE ( [Chart Entries], fact_chart_entry[chart_date] <> FirstSnapshot )
    )

// Chart entries at position 1.  [table: fact_chart_entry]
Days at #1 =
CALCULATE ( [Chart Entries], fact_chart_entry[chart_position] = 1 )

// Best (lowest) chart position.  [table: fact_chart_entry]
Best Position =
MIN ( fact_chart_entry[chart_position] )

// ---------------------------------------------------------------- Artists
// Chart entries split between credited artists; sums exactly to Chart Entries.  [table: fact_chart_entry]
Artist Weighted Chart Days =
SUMX (
    bridge_track_artist,
    bridge_track_artist[attribution_weight]
        * CALCULATE (
            [Chart Entries],
            TREATAS ( { bridge_track_artist[track_key] }, dim_track[track_key] )
        )
)

// Chart entries on which the artist is credited, counted in full.  [table: fact_chart_entry]
Artist Credited Chart Days =
CALCULATE (
    [Chart Entries],
    CROSSFILTER ( bridge_track_artist[track_key], dim_track[track_key], BOTH )
)

// Artist's weighted chart days as a share of ALL chart entries in the selected period (only date filters are kept in the denominator).  [table: fact_chart_entry]
Artist Share of Chart =
DIVIDE (
    [Artist Weighted Chart Days],
    CALCULATE (
        [Chart Entries],
        REMOVEFILTERS ( dim_artist ),
        REMOVEFILTERS ( bridge_track_artist ),
        REMOVEFILTERS ( dim_track ),
        REMOVEFILTERS ( dim_track_version ),
        REMOVEFILTERS ( mart_track_performance )
    )
)

// ---------------------------------------------------------------- Point in time
// Share of entries whose version on that day was a single (SCD2).  [table: fact_chart_entry]
Single Share =
DIVIDE ( CALCULATE ( [Chart Entries], dim_track_version[album_type] = "single" ), [Chart Entries] )

// Share of entries whose version on that day was explicit (SCD2).  [table: fact_chart_entry]
Explicit Share =
DIVIDE ( CALCULATE ( [Chart Entries], dim_track_version[is_explicit] = TRUE () ), [Chart Entries] )

// ---------------------------------------------------------------- Track life
// Median total days on chart per track.  [table: mart_track_performance]
Median Chart Life (days) =
MEDIAN ( mart_track_performance[total_chart_days] )

// Share of tracks whose best position was their debut position.  [table: mart_track_performance]
Peaked on Debut % =
DIVIDE (
    CALCULATE (
        COUNTROWS ( mart_track_performance ),
        mart_track_performance[peaked_on_debut] = TRUE ()
    ),
    COUNTROWS ( mart_track_performance )
)

// Fair longevity comparison: chart days within 180 days of debut.  [table: mart_track_performance]
Median Days in First 180 =
CALCULATE (
    MEDIAN ( mart_track_performance[chart_days_first_180] ),
    mart_track_performance[is_left_censored] = FALSE (),
    mart_track_performance[has_full_180_day_window] = TRUE ()
)

// ---------------------------------------------------------------- Chart health
// Artist concentration (Herfindahl-Hirschman index).  [table: mart_daily_chart]
Avg Artist HHI =
AVERAGE ( mart_daily_chart[artist_hhi] )

// Share of the chart held by holiday catalogue tracks.  [table: mart_daily_chart]
Holiday Track Share =
AVERAGE ( mart_daily_chart[holiday_track_share] )

// Share of the chart held by collaborations.  [table: mart_daily_chart]
Collaboration Share =
AVERAGE ( mart_daily_chart[collaboration_share] )

// ---------------------------------------------------------------- Artists
// Distinct individual artists on the chart (collaborations split; the 'Various Artists' compilation placeholder is not an artist).  [table: fact_chart_entry]
Artists Charting =
CALCULATE (
    DISTINCTCOUNT ( bridge_track_artist[artist_key] ),
    CROSSFILTER ( fact_chart_entry[track_key], dim_track[track_key], BOTH ),
    dim_artist[artist_name] <> "Various Artists"
)

// ---------------------------------------------------------------- Chart
// Top of the popularity scale (gauge maximum).  [table: fact_chart_entry]
Popularity Max =
100

// Distance from average popularity to 100 (progress bars).  [table: fact_chart_entry]
Popularity Remainder =
[Popularity Max] - [Avg Popularity]

// ---------------------------------------------------------------- Artists
// Distinct tracks credited to the artist(s) in context.  [table: fact_chart_entry]
Artist Tracks =
CALCULATE (
    DISTINCTCOUNT ( bridge_track_artist[track_key] ),
    CROSSFILTER ( fact_chart_entry[track_key], dim_track[track_key], BOTH )
)

// Average popularity of the artist's chart entries.  [table: fact_chart_entry]
Artist Avg Popularity =
CALCULATE (
    [Avg Popularity],
    CROSSFILTER ( bridge_track_artist[track_key], dim_track[track_key], BOTH )
)

// Days the artist held position 1.  [table: fact_chart_entry]
Artist Days at #1 =
COALESCE (
    CALCULATE (
        [Days at #1],
        CROSSFILTER ( bridge_track_artist[track_key], dim_track[track_key], BOTH )
    ),
    0
)

// Best chart position reached by the artist.  [table: fact_chart_entry]
Artist Best Position =
CALCULATE (
    [Best Position],
    CROSSFILTER ( bridge_track_artist[track_key], dim_track[track_key], BOTH )
)

// One-sentence summary of the selected artist.  [table: fact_chart_entry]
Artist Insight =
VAR Artist = SELECTEDVALUE ( dim_artist[artist_name] )
RETURN
    IF (
        ISBLANK ( Artist ),
        "Select an artist to see their chart story.",
        Artist & " holds " & FORMAT ( [Artist Share of Chart], "0.0%" )
            & " of all chart slots across " & FORMAT ( [Artist Tracks], "0" )
            & " songs, with " & FORMAT ( [Artist Days at #1], "0" ) & " days at #1."
    )

// ---------------------------------------------------------------- Song
// Chart journey: 51 minus chart position (50 = #1). For the selected song, or the top-ranked song in the current selection.  [table: fact_chart_entry]
Chart Strength =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    CALCULATE (
        51 - MIN ( fact_chart_entry[chart_position] ),
        dim_track[chart_rank] = FocusRank
    )

// ---------------------------------------------------------------- Track life
// Total days on chart (respects artist selection).  [table: mart_track_performance]
Days on Chart =
CALCULATE (
    SUM ( mart_track_performance[total_chart_days] ),
    CROSSFILTER ( bridge_track_artist[track_key], dim_track[track_key], BOTH )
)

// Number of tracks.  [table: mart_track_performance]
Tracks =
COUNTROWS ( mart_track_performance )

// The longest-charting song in the current selection.  [table: mart_track_performance]
Top Track =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    CALCULATE ( MAX ( dim_track[track_label] ), dim_track[chart_rank] = FocusRank )

// ---------------------------------------------------------------- Song
// Best chart position reached. For the selected song, or the top-ranked song in the current selection.  [table: mart_track_performance]
Peak Position =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    CALCULATE (
        MIN ( mart_track_performance[peak_position] ),
        dim_track[chart_rank] = FocusRank
    )

// Chart position on the debut day. For the selected song, or the top-ranked song in the current selection.  [table: mart_track_performance]
Debut Position =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    CALCULATE (
        MIN ( mart_track_performance[debut_position] ),
        dim_track[chart_rank] = FocusRank
    )

// Release year (as text, so cards show 2024, not 2K). For the selected song, or the top-ranked song in the current selection.  [table: mart_track_performance]
Release Year =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    CALCULATE (
        FORMAT ( YEAR ( MIN ( mart_track_performance[release_date] ) ), "0" ),
        dim_track[chart_rank] = FocusRank
    )

// Whether the song is explicit. For the selected song, or the top-ranked song in the current selection.  [table: mart_track_performance]
Explicit Label =
VAR FocusRank = MIN ( dim_track[chart_rank] )
VAR IsExplicit =
    CALCULATE (
        COUNTROWS ( mart_track_performance ),
        dim_track[chart_rank] = FocusRank,
        mart_track_performance[debut_is_explicit] = TRUE ()
    )
RETURN
    IF ( ISBLANK ( FocusRank ), BLANK (), IF ( IsExplicit > 0, "Yes", "No" ) )

// Release type when the song debuted. For the selected song, or the top-ranked song in the current selection.  [table: mart_track_performance]
Album Type =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    CALCULATE (
        SELECTEDVALUE ( mart_track_performance[debut_album_type] ),
        dim_track[chart_rank] = FocusRank
    )

// Name of the song the Songs page describes. For the selected song, or the top-ranked song in the current selection.  [table: mart_track_performance]
Song =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    CALCULATE ( MAX ( dim_track[track_label] ), dim_track[chart_rank] = FocusRank )

// Total days on chart. For the selected song, or the top-ranked song in the current selection.  [table: mart_track_performance]
Song Days on Chart =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    CALCULATE (
        SUM ( mart_track_performance[total_chart_days] ),
        dim_track[chart_rank] = FocusRank
    )

// Days at position 1. For the selected song, or the top-ranked song in the current selection.  [table: fact_chart_entry]
Song Days at #1 =
VAR FocusRank = MIN ( dim_track[chart_rank] )
RETURN
    COALESCE (
        CALCULATE ( [Days at #1], dim_track[chart_rank] = FocusRank ),
        IF ( NOT ISBLANK ( FocusRank ), 0 )
    )
